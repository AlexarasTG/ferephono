{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Floating Whisprer",
  "version": "0.1.0",
  "identifier": "com.alexarasTG.FloatingWhisprer",
  "build": {
    "beforeBuildCommand": "npm run check:runtime",
    "beforeDevCommand": "npm run check:runtime",
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "url": "status-panel/index.html",
        "title": "Floating Whisprer",
        "width": 320,
        "height": 240,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.icns"],
    "resources": [
      "runtime/whisper-cli",
      "runtime/ggml-base.en.bin"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "12.0"
    }
  }
}
